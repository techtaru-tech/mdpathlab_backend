# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma.config.ts already does `import "dotenv/config"` so this file is picked up.

DATABASE_URL="postgresql://mdpathlabs:mdpathlabs@localhost:5433/mdpathlabs?schema=public"
REDIS_URL="redis://localhost:6380"

# Defense-in-depth only — every actual past-time/availability decision uses explicit +05:30
# construction (src/common/ist-time.ts), never the server's local time. This just keeps ad hoc
# server logs/timestamps readable in IST regardless of deployment host.
TZ=Asia/Kolkata

PORT=3001
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN_DAYS=7
ADMIN_JWT_EXPIRES_IN_HOURS=12

# First admin login — created by the seed script. Change this password before going anywhere
# near production; it exists purely so there's a way in on day one.
SEED_ADMIN_EMAIL="admin@mdpathlabs.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# OTP tuning — hashed + time-limited + rate-limited by design, not the SmartLab pattern.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# When true, OTP is echoed back in the API response for local dev only — never in production.
OTP_DEV_ECHO=true

# Razorpay — TEST mode keys (rzp_test_...). Get your own free test account at
# https://dashboard.razorpay.com/signup — no KYC needed for test mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cancellation window before the scheduled slot, in hours (FSD default).
CANCELLATION_WINDOW_HOURS=2

# Home-collection fee tiers (client-provided) — distance is measured from the patient's
# address to the nearest ACTIVE CollectionCenter that has coordinates set (see the
# CollectionCenter table / admin panel), not from a static coordinate here.
HOME_COLLECTION_FREE_KM=5
HOME_COLLECTION_TIER2_KM=10
HOME_COLLECTION_TIER2_FEE=100
HOME_COLLECTION_TIER3_KM=20
HOME_COLLECTION_TIER3_FEE=200

# How long an ONLINE order's slot claim is honored while payment is PENDING/FAILED before it
# stops counting toward slot capacity. Does not touch the order itself — no status is changed,
# nothing is cancelled or deleted; it simply stops occupying the slot for new bookings.
SLOT_RESERVATION_TTL_MINUTES=30

# SMS gateway (Kanpur City Online HTTP API). Leave USERNAME/PASSWORD empty to keep SMS off —
# OTPs are then only printed in the server log (local development). The DLT Content Id is the
# DLT-approved template's id; its text must match OTP_TEMPLATE in src/sms/sms.service.ts exactly.
SMS_API_BASE_URL=https://smsweb.kanpurcityonline.com
SMS_API_USERNAME=
SMS_API_PASSWORD=
SMS_SENDER_ID=MDPLBS
SMS_OTP_DLT_CONTENT_ID=1701178022625968309

# Wallet welcome bonus credited once to a brand-new patient account on first OTP login (0 = disabled)
WALLET_SIGNUP_BONUS=250

# Public base URL of this API as the customer app sees it (include /api behind the reverse proxy).
# Used to turn stored /uploads/... paths into absolute image URLs in GET /home.
PUBLIC_API_URL=http://localhost:3011
# Optional — image returned when a category/package/test/coupon has no imageUrl yet.
# HOME_PLACEHOLDER_IMAGE_URL=

# Outgoing email (transactional: booking confirmed, report ready, home visit updates).
# Leave SMTP_PASSWORD empty to keep email off — each attempt is then logged as SKIPPED.
# Port 465 = SSL, 587 = STARTTLS. The server certificate is always verified.
SMTP_HOST=mail.mdpathlabs.com
SMTP_PORT=465
SMTP_USER=info@mdpathlabs.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@mdpathlabs.com
SMTP_FROM_NAME=MD Path Labs
# Base URL used for links inside emails. Switch to https://mdpathlabs.com when the platform moves there.
APP_PUBLIC_URL=http://localhost:8080
