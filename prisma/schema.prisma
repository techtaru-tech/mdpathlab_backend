// MD Path Labs — core schema (M0)
// Flow borrowed conceptually from a prior sibling project (SmartLab) — parameters/profiles/packages
// catalogue shape, order status lifecycle — but reimplemented cleanly: real join tables (no
// comma-separated ID strings), a single discount mechanism, a single slot mechanism, and hashed/
// time-limited/rate-limited OTPs from day one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

enum UserRole {
  PATIENT
  PHLEBOTOMIST
}

model User {
  id            String        @id @default(cuid())
  phone         String        @unique
  role          UserRole      @default(PATIENT)
  name          String?
  email         String?
  dob           DateTime?
  gender        Gender?
  city          String?
  status        AccountStatus @default(ACTIVE)
  walletBalance Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  familyMembers      FamilyMember[]
  addresses          Address[]
  orders             Order[]
  cartItems          CartItem[]
  phlebotomist       Phlebotomist?
  prescriptions      Prescription[]
  deviceTokens       DeviceToken[]
  walletTransactions WalletTransaction[]
  reviews            Review[]
  notifications      Notification[]

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  deviceTokens DeviceToken[]

  @@map("admin_users")
}

// Phone + OTP is shared by patients and phlebotomists; keyed by phone so it can be
// requested before an account necessarily exists yet (first-time patient sign-up).
model OtpChallenge {
  id          String     @id @default(cuid())
  phone       String
  codeHash    String
  purpose     OtpPurpose @default(LOGIN)
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_challenges")
}

enum OtpPurpose {
  LOGIN
  SIGNUP
}

model FamilyMember {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  gender    Gender?
  dob       DateTime?
  // Captured directly rather than derived from dob — a lab booking needs the patient's age for
  // reference ranges/prep instructions, and most users know their family member's age but not
  // their exact date of birth.
  age       Int?
  createdAt DateTime  @default(now())

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@map("family_members")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  houseNo   String?
  line1     String
  landmark  String?
  city      String
  state     String?
  pincode   String
  lat       Float?
  lng       Float?
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  orders Order[]

  @@map("addresses")
}

// ---------- Cart ----------
// Server-persisted (not client-only state) so the header's cart badge and multi-device access
// both reflect the same truth — matches the FSD's "view cart from anywhere" expectation.

enum CartItemType {
  PARAMETER
  PROFILE
  PACKAGE
  RADIOLOGY
}

// Deduplication key is (userId, itemType, itemId, familyMemberId) — same user/item/patient
// combination is one cart row; a different patient (or no patient) for the same item is a
// separate, legitimate row. Enforced at the database level by two partial unique indexes added
// by hand in migration `cart_item_dedupe_unique_index` (Prisma's schema DSL has no syntax for a
// partial/WHERE-clause unique index, and a plain composite @@unique would silently NOT dedupe
// rows where familyMemberId is NULL, since Postgres treats NULL as distinct from NULL in unique
// constraints — one index covers familyMemberId IS NOT NULL, the other familyMemberId IS NULL).
model CartItem {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType       CartItemType
  itemId         String
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id])
  createdAt      DateTime      @default(now())

  @@map("cart_items")
}

// ---------- Catalogue ----------

enum SampleCollectionMode {
  HOME
  LAB
  BOTH
}

enum CatalogueStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  status      CatalogueStatus @default(ACTIVE)
  // "Why {category} checkups matter" — one line per bullet point, shown in the header's
  // mega-menu for this category. Optional: a category with none just gets a generic fallback in
  // the frontend rather than an empty panel.
  description String?

  parameters     Parameter[]
  profiles       Profile[]
  packages       Package[]
  radiologyTests RadiologyTest[]

  @@map("categories")
}

// Atomic lab marker, e.g. a single blood component (Haemoglobin, RBC Count). Admin-managed via
// the Parameters module — used as a ProfileParameter component of a customer-facing Test
// (Profile). The 8 pre-existing rows are a historical exception: they were created before the
// Test/Profile admin module existed and are themselves customer-facing test listings (not atomic
// components) — see CatalogueService.listTests() for how both are served together.
model Parameter {
  id                    String               @id @default(cuid())
  name                  String
  slug                  String               @unique
  // Stable admin-facing marker code (distinct from the URL slug and the internal id) — used to
  // match rows during CSV import/update. Optional since the 8 pre-existing rows predate it;
  // plain @unique is correct here (not a partial index) because multiple NULLs are the desired
  // behavior for "no code assigned yet", unlike the NULL-as-a-real-scope-value cases elsewhere.
  code                  String?              @unique
  shortDescription      String?
  mrp                   Int
  price                 Int
  sampleCollection      SampleCollectionMode @default(HOME)
  sampleCollectionFee   Int                  @default(0)
  reportTimeHours       Int
  fastingRequired       Boolean              @default(false)
  fastingHours          Int?
  categoryId            String?
  category              Category?            @relation(fields: [categoryId], references: [id])
  status                CatalogueStatus      @default(ACTIVE)
  // Admin-curated marketing badge, e.g. "Most booked" — display-only, not clinical.
  tag                   String?
  // Placeholder sub-marker count (e.g. CBC's 28 markers) until real per-test breakdown data lands.
  displayParameterCount Int?
  // Free text (e.g. "13.0 - 17.0 g/dL", "Negative", "Male: 13-17, Female: 12-15") — printed on
  // the auto-generated report next to the lab's entered value (see ReportGeneratorService). Free
  // text rather than numeric min/max because many real parameters aren't a plain numeric range.
  referenceRange         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  profileLinks    ProfileParameter[]
  packageItems    PackageItem[]
  labResultValues LabResultValue[]

  @@map("parameters")
}

// A named bundle of parameters — the customer-facing "Test" going forward (e.g. CBC, Thyroid
// Profile). New Tests are created here, with real ProfileParameter links to atomic Parameter
// rows for "parameters covered" — never a comma-separated list.
model Profile {
  id                      String               @id @default(cuid())
  name                    String
  slug                    String               @unique
  // Stable admin-facing test code (e.g. "CBC001") — the FSD's "Test Code". Required: every new
  // Test needs one, and the table starts empty so there's no backfill concern.
  testCode                String               @unique
  shortDescription        String?
  // Free text, e.g. "Blood", "Urine" — no existing field represented this; genuinely new.
  sampleType              String?
  // Prep beyond fasting (which fastingRequired/fastingHours below already cover), e.g. "Avoid
  // vitamin C supplements for 48 hours" — genuinely new, no existing field represented this.
  preparationInstructions String?
  mrp                     Int
  price                   Int
  sampleCollection        SampleCollectionMode @default(HOME)
  sampleCollectionFee     Int                  @default(0)
  reportTimeHours         Int
  fastingRequired         Boolean              @default(false)
  fastingHours            Int?
  categoryId              String?
  category                Category?            @relation(fields: [categoryId], references: [id])
  status                  CatalogueStatus      @default(ACTIVE)
  // Same marketing-badge concept as Parameter.tag — Profile never had it since it's brand new.
  tag                     String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  parameters   ProfileParameter[]
  packageItems PackageItem[]

  @@map("profiles")
}

// A radiology/imaging service — X-Ray, CT, MRI, Ultrasound, etc. Deliberately its own table
// rather than a Profile: unlike a blood test it's never bundled from Parameters, and it can only
// ever be fulfilled by the customer physically visiting a partner Lab (never home-collected) —
// see LabsService.findMatchingLab, reused by OrdersService.priceOrder for radiology bookings the
// same way it already routes HOME-collection orders by pincode + item coverage.
model RadiologyTest {
  id                      String          @id @default(cuid())
  name                    String
  slug                    String          @unique
  testCode                String          @unique
  shortDescription        String?
  // Free text, e.g. "X-Ray", "CT Scan", "MRI", "Ultrasound" — lets the storefront/admin group and
  // badge these without a rigid enum that would need a migration for every new imaging type.
  modality                String?
  preparationInstructions String?
  mrp                     Int
  price                   Int
  reportTimeHours         Int
  fastingRequired         Boolean         @default(false)
  fastingHours            Int?
  categoryId              String?
  category                Category?       @relation(fields: [categoryId], references: [id])
  status                  CatalogueStatus @default(ACTIVE)
  tag                     String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@map("radiology_tests")
}

// Real join table — deliberately not SmartLab's comma-separated ID string.
model ProfileParameter {
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@id([profileId, parameterId])
  @@map("profile_parameters")
}

// A health package bundling profiles and/or parameters (e.g. Full Body Checkup).
model Package {
  id                    String          @id @default(cuid())
  name                  String
  slug                  String          @unique
  subtitle              String?
  mrp                   Int
  price                 Int
  reportTimeHours       Int
  fastingRequired       Boolean         @default(false)
  fastingHours          Int?
  bestFor               String?
  badge                 String?
  // Marketing bullet points shown on cards/detail pages — admin-curated, not derived from `items`.
  highlights            String[]        @default([])
  isFeatured            Boolean         @default(false)
  status                CatalogueStatus @default(ACTIVE)
  // Placeholder count shown until real included-item data lands (client's Test/Package CSV) and
  // `items` below is properly populated — never fabricate PackageItem links to guess at this.
  displayParameterCount Int?
  // Optional — powers the header mega-menu's "Preventive Packages for {category}" panel. A
  // package with no category just never appears there (it still shows everywhere else it always
  // has, e.g. /packages).
  categoryId            String?
  category              Category?       @relation(fields: [categoryId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items PackageItem[]

  @@map("packages")
}

enum PackageItemType {
  PARAMETER
  PROFILE
}

model PackageItem {
  id          String          @id @default(cuid())
  packageId   String
  package     Package         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  itemType    PackageItemType
  parameterId String?
  parameter   Parameter?      @relation(fields: [parameterId], references: [id])
  profileId   String?
  profile     Profile?        @relation(fields: [profileId], references: [id])

  @@map("package_items")
}

// ---------- Discounts (single mechanism, not SmartLab's two) ----------

enum CouponType {
  PERCENT
  FLAT
}

model Coupon {
  id            String          @id @default(cuid())
  code          String          @unique
  type          CouponType
  value         Int
  minOrderValue Int?
  maxDiscount   Int?
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  // Caps how many times ONE user can redeem this code — separate from `usageLimit`, which caps
  // total redemptions across everyone. Null means no per-user cap (same convention as
  // usageLimit). Enforced by counting that user's non-cancelled past orders against this coupon,
  // not a stored counter, since "how many times has this user used it" is always derivable from
  // Order rows and never needs its own mutable state.
  perUserLimit  Int?
  usedCount     Int             @default(0)
  status        CatalogueStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())

  orders Order[]

  @@map("coupons")
}

// ---------- Wallet (ledger of credits/debits; User.walletBalance is the running total) ----------

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model WalletTransaction {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id])
  type              WalletTransactionType
  // Always positive — sign is implied by `type`, never encoded in the number itself.
  amount            Int
  reason            String
  orderId           String?
  order             Order?                @relation(fields: [orderId], references: [id])
  // Set only for "Add Money to Wallet" top-ups — the unique constraint is what makes verifying a
  // top-up idempotent: the browser's own verify call and the Razorpay webhook can both race to
  // credit the same payment, and only the first one's insert succeeds.
  razorpayOrderId   String?               @unique
  razorpayPaymentId String?
  createdAt         DateTime              @default(now())

  @@map("wallet_transactions")
}

// ---------- Slots (single mechanism, not SmartLab's two) ----------

model Slot {
  id        String  @id @default(cuid())
  label     String
  startTime String
  endTime   String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  // Dormant — never read by application code. SlotAvailability (below) is the authoritative
  // capacity source; this column is left in place, untouched, for a possible future cleanup.
  capacity  Int?

  orders            Order[]
  availabilityRules SlotAvailability[]

  @@map("slots")
}

// Optional per-(slot, date) capacity override. Absence of a matching row means "unlimited" —
// identical to today's unconfigured behavior — so this table can start empty with zero effect on
// any existing slot. A row's (collectionType, collectionCenterId) combination selects its scope:
//   (null, null)      -> applies globally, to HOME and CENTER alike
//   (HOME, null)      -> applies only to HOME bookings for this slot/date
//   (CENTER, null)    -> applies to CENTER bookings at ANY centre for this slot/date
//   (CENTER, centreX) -> applies only to CENTER bookings at that specific centre
// Precedence when resolving which row governs a given booking (most specific first):
//   HOME:   (HOME, null) -> (null, null) -> unlimited
//   CENTER: (CENTER, centreId) -> (CENTER, null) -> (null, null) -> unlimited
// Prisma's schema DSL has no syntax for a partial/WHERE-clause unique index, so the actual
// uniqueness guarantee (one row per scope shape per slot/date — see the NULL-distinctness note in
// the cart_items migration for why a naive composite @@unique would not enforce this) and a CHECK
// constraint (collectionCenterId can only be set when collectionType = CENTER) live by hand in
// migration `slot_availability`, not as attributes on this model.
model SlotAvailability {
  id                 String            @id @default(cuid())
  slotId             String
  slot               Slot              @relation(fields: [slotId], references: [id])
  date               DateTime          @db.Date
  collectionType     CollectionType?
  collectionCenterId String?
  collectionCenter   CollectionCenter? @relation(fields: [collectionCenterId], references: [id])
  capacity           Int
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("slot_availability")
}

// ---------- Collection centers & field agents ----------
// Schema + admin-side management ships in Phase 1; the phlebotomist-facing
// app and its dedicated API surface are Phase 2 — see the development plan.

model City {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  collectionCenters CollectionCenter[]
  cityPrices        CityPrice[]
}

// City-specific price override for a Parameter/Profile("Test")/Package row. Absence of a row for
// a given (cityId, itemType, itemId) means "use that item's own mrp/price column" — identical to
// today's single-price behavior — so this table can start empty with zero effect on any existing
// item. itemId is deliberately not a hard FK (same convention as OrderItem.itemId/CartItem.itemId)
// since it points into one of three different tables depending on itemType.
model CityPrice {
  id        String       @id @default(cuid())
  cityId    String
  city      City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  itemType  CartItemType
  itemId    String
  mrp       Int
  price     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([cityId, itemType, itemId])
  @@map("city_prices")
}

model CollectionCenter {
  id      String          @id @default(cuid())
  name    String
  address String
  cityId  String?
  city    City?           @relation(fields: [cityId], references: [id])
  phone   String?
  lat     Float?
  lng     Float?
  status  CatalogueStatus @default(ACTIVE)

  orders            Order[]
  availabilityRules SlotAvailability[]

  @@map("collection_centers")
}

enum PhlebotomistStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model Phlebotomist {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String             @unique
  vehicleType      String?
  vehicleNumber    String?
  coverageCity     String?
  status           PhlebotomistStatus @default(ACTIVE)
  rating           Float?
  totalCollections Int                @default(0)
  createdAt        DateTime           @default(now())
  // Which partner Lab this phlebotomist belongs to — null for the pre-existing, centrally-run
  // phlebotomists (unaffected by the multi-lab feature). A lab's own phlebotomists always have
  // this set and are only ever assignable to that same lab's orders.
  labId            String?
  lab              Lab?               @relation(fields: [labId], references: [id])
  // Last self-reported GPS position — a single "where are they right now" pointer, not a
  // location history table, since the only consumer (the customer's live-tracking view, once
  // `onTheWayAt` is set on their order) only ever needs the current position.
  lastLat          Float?
  lastLng          Float?
  lastLocationAt   DateTime?

  orders Order[]

  @@map("phlebotomists")
}

// ---------- Multi-lab marketplace ----------
// A partner lab, registered by admin after a franchise inquiry → phone conversation (see
// FranchiseInquiry). Coverage is a plain pincode list (not radius/lat-lng, per the client's
// choice) — a booking automatically routes to a Lab whose servicePincodes includes the
// customer's address pincode and whose LabCatalogueItem rows cover every item in the order.
// No pincode match anywhere -> checkout is blocked (see PincodeNotifyRequest), never silently
// falls back to the central operation.
model Lab {
  id              String        @id @default(cuid())
  name            String
  ownerName       String?
  email           String        @unique
  passwordHash    String
  phone           String
  servicePincodes String[]
  status          AccountStatus @default(ACTIVE)
  // Printed on the auto-generated report's letterhead/footer (see ReportGeneratorService) — a
  // real diagnostic report needs to state which lab actually processed the sample, its
  // accreditation, and who verified the results, not just "MD Path Lab" generically.
  address                  String?
  accreditationNumber      String?
  pathologistName          String?
  pathologistQualification String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  phlebotomists  Phlebotomist[]
  orders         Order[]
  catalogueItems LabCatalogueItem[]
  prescriptions  Prescription[]

  @@map("labs")
}

// Which master-catalogue items a lab can fulfill — admin sets this when registering/editing the
// lab. itemId is deliberately not a hard FK (same convention as CityPrice/OrderItem.itemId)
// since it points into one of three different tables depending on itemType.
model LabCatalogueItem {
  id       String       @id @default(cuid())
  labId    String
  lab      Lab          @relation(fields: [labId], references: [id], onDelete: Cascade)
  itemType CartItemType
  itemId   String

  @@unique([labId, itemType, itemId])
  @@map("lab_catalogue_items")
}

// Raw per-parameter result values a lab enters for a booking assigned to it. Feeds the existing
// admin Report workflow (admin still generates/approves the actual Report) — this table never
// generates a report file itself; that stays a manual admin step until LIMS integration lands.
model LabResultValue {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])
  value       String
  unit        String?
  enteredAt   DateTime  @default(now())

  @@unique([orderId, parameterId])
  @@map("lab_result_values")
}

// Captured when a customer's address pincode matches no Lab at checkout — lets admin follow up
// manually and, once a Lab is later registered for that pincode, triggers a best-effort push
// notification to that phone's User (no SMS gateway exists yet, see NotificationsService).
enum PincodeNotifyStatus {
  PENDING
  NOTIFIED
}

model PincodeNotifyRequest {
  id        String              @id @default(cuid())
  phone     String
  pincode   String
  status    PincodeNotifyStatus @default(PENDING)
  createdAt DateTime            @default(now())

  @@map("pincode_notify_requests")
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PHLEBOTOMIST_ASSIGNED
  SAMPLE_COLLECTED
  IN_LAB
  REPORT_READY
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum CollectionType {
  HOME
  CENTER
}

// FSD §2.4 "Payment Mode (Cash/UPI)" — the instrument used at the moment of physical
// collection, distinct from `PaymentMethod` (ONLINE/COD), which is the channel chosen at checkout.
enum CollectionPaymentMode {
  CASH
  UPI
}

model Order {
  id                    String                 @id @default(cuid())
  orderNumber           String                 @unique
  userId                String
  user                  User                   @relation(fields: [userId], references: [id])
  status                OrderStatus            @default(PENDING_PAYMENT)
  paymentStatus         PaymentStatus          @default(PENDING)
  paymentMethod         PaymentMethod          @default(ONLINE)
  collectionType        CollectionType         @default(HOME)
  addressId             String?
  address               Address?               @relation(fields: [addressId], references: [id])
  collectionCenterId    String?
  collectionCenter      CollectionCenter?      @relation(fields: [collectionCenterId], references: [id])
  slotId                String?
  slot                  Slot?                  @relation(fields: [slotId], references: [id])
  scheduledDate         DateTime?
  subtotal              Int
  discount              Int                    @default(0)
  collectionFee         Int                    @default(0)
  // Wallet redeemed against this order — deducted from subtotal-discount+fee to reach `total`,
  // the amount actually charged via paymentMethod. Refunded back to the wallet on cancellation.
  walletAmountUsed      Int                    @default(0)
  total                 Int
  couponId              String?
  coupon                Coupon?                @relation(fields: [couponId], references: [id])
  phlebotomistId        String?
  phlebotomist          Phlebotomist?          @relation(fields: [phlebotomistId], references: [id])
  // Which partner Lab is fulfilling this order — set at checkout time by pincode+catalogue
  // match (see Lab). Null means it wasn't routed to a partner lab (e.g. CENTER collection, or
  // this order predates the multi-lab feature).
  labId                 String?
  lab                   Lab?                   @relation(fields: [labId], references: [id])
  // Phlebotomist-workflow-only event (FSD §2.4) — deliberately NOT part of `status`, since the
  // patient-facing status timeline (FSD §1.1.3.2: Booked → Phlebotomist Assigned → Sample
  // Collected → In Lab → Report Ready) has no "Reached" step. Set once, on arrival; never cleared.
  reachedAt             DateTime?
  // Pay-at-Collection payment recording (FSD §2.4) — COD is this codebase's representation of
  // "Pay at Collection" (confirmed via the checkout note "Booking confirmed — pay on collection").
  // Set once, together, by the phlebotomist payment-collection endpoint; never cleared/edited —
  // correction/reversal is explicitly out of scope for this phase.
  collectedAmount       Int?
  collectionPaymentMode CollectionPaymentMode?
  collectedAt           DateTime?
  // Handover to Lab (FSD §2.5) — barcode is stored as submitted (scan or manual entry, no format
  // assumed). Once set, Order.status becomes IN_LAB (an existing, already patient-facing status —
  // not a new one), which is what drives the patient tracking timeline (§1.1.3.2) to "In Lab".
  sampleBarcode         String?
  handedOverAt          DateTime?
  // The lab's own acknowledgment of receipt — deliberately separate from the phlebotomist's
  // handedOverAt, so "phlebo says they dropped it off" and "lab confirms it actually arrived" are
  // two distinct, independently-timestamped events instead of one side's action silently implying
  // the other. This is what now flips Order.status to IN_LAB (see LabOrdersService.receiveSample) —
  // handover itself no longer does, a deliberate change from the original single-step design.
  sampleReceivedAt      DateTime?
  // Workflow-only, same convention as reachedAt/handedOverAt above — no new OrderStatus values.
  assignmentStatus         PhlebotomistAssignmentStatus?
  assignmentRejectedReason String?
  onTheWayAt               DateTime?
  // A short code the patient reads out to the phlebotomist at the doorstep (generated when the
  // phlebotomist marks "reached", sent to the patient by push notification — dev-echoed in the
  // API response too, same convention as the login OTP, since there's no real SMS gateway wired
  // up). Verifying it is a precondition for sample-collected, same role login OTP plays for auth.
  collectionOtp            String?
  collectionOtpVerifiedAt  DateTime?
  razorpayOrderId       String?
  razorpayPaymentId     String?
  razorpaySignature     String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  items              OrderItem[]
  statusLogs         OrderStatusLog[]
  reports            Report[]
  prescriptions      Prescription[]
  walletTransactions WalletTransaction[]
  review             Review?
  labResultValues    LabResultValue[]

  @@map("orders")
}

enum PhlebotomistAssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType       CartItemType  @default(PARAMETER)
  itemId         String
  itemName       String
  mrp            Int
  price          Int
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id])
  sample         OrderSample?

  @@map("order_items")
}

// One row per test/package line item on a HOME-collection order — the phlebotomist fills these
// in during collection (tube type, quantity, a physical label id) and marks each collected;
// sample-collected requires every item on the order to have one collected before it can proceed,
// which is the "all required samples collected" completeness check for multi-test bookings.
model OrderSample {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  tubeType    String?
  quantity    String?
  label       String?
  collectedAt DateTime?

  @@map("order_samples")
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  @@map("order_status_logs")
}

// ---------- Reports ----------
// Manual entry + upload by default per the development plan's finding — SmartLab never had a real
// LIS/analyzer feed either, so this isn't scoped as an integration unless the client confirms otherwise.

enum ReportStatus {
  PENDING
  UPLOADED
  APPROVED
}

model Report {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileUrl    String?
  status     ReportStatus @default(PENDING)
  uploadedBy String?
  approvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@map("reports")
}

// ---------- Prescriptions ----------
// Patient-initiated upload (photo/PDF of a doctor's prescription), optionally tied to an order,
// reviewed by admin. Direct user request, not FSD-derived.

enum PrescriptionStatus {
  PENDING
  REVIEWED
}

// The richer, lab-side review pipeline — only meaningful once a lab is assigned (labId set), so
// it starts null for a prescription no lab covers yet (that one just stays on the simple
// PrescriptionStatus/admin-review path above, unchanged). ACTION_REQUIRED is a side branch back
// to the patient, not a terminal state — a reply returns it to UNDER_REVIEW.
enum LabPrescriptionStage {
  UPLOADED
  UNDER_REVIEW
  ACTION_REQUIRED
  REVIEWED
  READY_FOR_BOOKING
  BOOKING_CONFIRMED
}

model Prescription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?             @relation(fields: [orderId], references: [id])
  fileUrl   String
  note      String?
  status    PrescriptionStatus @default(PENDING)
  adminNote String?
  createdAt DateTime           @default(now())

  // Routes the prescription to the partner lab covering the patient's pincode, same matching
  // rule as order checkout (see LabsService.findMatchingLab) — null when no lab covers it yet,
  // in which case it just stays visible to admin like before.
  pincode String?
  labId   String?
  lab     Lab?    @relation(fields: [labId], references: [id])

  labStage           LabPrescriptionStage?
  // Lab's message to the patient when labStage = ACTION_REQUIRED, and the patient's reply to it —
  // one round trip is enough for "which of these two tests did the doctor mean" style questions;
  // a reply flips labStage back to UNDER_REVIEW so the lab knows to look again.
  clarificationNote  String?
  patientReply       String?
  reviewedAt         DateTime?
  confirmedAt        DateTime?
  recommendedTests   PrescriptionRecommendedTest[]

  @@map("prescriptions")
}

// One row per test the lab identified from the prescription (or was asked to check and
// couldn't fulfill) — a snapshot of name/price/mrp at review time, not a live FK into
// Parameter/Profile/Package, so a later catalogue price change never silently rewrites what the
// patient already saw and confirmed. `selected` is the patient's own choice (defaults to true —
// the doctor recommended it — but they can deselect before booking); `available` is the lab's.
model PrescriptionRecommendedTest {
  id               String       @id @default(cuid())
  prescriptionId   String
  prescription     Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  itemType         CartItemType
  itemId           String
  name             String
  shortDescription String?
  price            Int
  mrp              Int
  available        Boolean      @default(true)
  unavailableNote  String?
  selected         Boolean      @default(true)
  createdAt        DateTime     @default(now())

  @@unique([prescriptionId, itemType, itemId])
  @@map("prescription_recommended_tests")
}

// ---------- Reviews ----------
// One review per completed order (report ready), moderated by admin before it counts toward the
// public average/count or appears in the homepage reviews list — mirrors Prescription.status's
// admin-review convention (PENDING until acted on) rather than auto-publishing.

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(cuid())
  orderId   String       @unique
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@map("reviews")
}

// ---------- Push notifications ----------
// A registered browser's FCM token, for one of two distinct realms — a patient/phlebotomist
// (User) or an admin (AdminUser), never both. Web push only for now (see DevicePlatform); a
// native app would add its own enum value here rather than a new model.

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

model DeviceToken {
  id          String         @id @default(cuid())
  token       String         @unique
  platform    DevicePlatform @default(WEB)
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("device_tokens")
}

// Persisted in-app notification history — separate from the fire-and-forget Firebase push
// NotificationsService already sends. A push can be missed (app closed, permission denied, no
// device token registered yet — see PHLEBOTOMIST_APP_SPEC.md's own "things that will trip you
// up" section) so the customer app needs a real, re-fetchable feed with read/unread state, not
// just "whatever push happened to arrive." Written alongside every push NotificationsService
// already sends, never as a replacement for it.
enum NotificationKind {
  BOOKING
  REPORT
  OFFER
  WALLET
  GENERAL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  kind      NotificationKind @default(GENERAL)
  // Same free-form payload shape already pushed to Firebase (type/orderId/status/etc.) — kept as
  // JSON so the app can route a tap without a second lookup, without this table needing a column
  // per possible payload shape.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

// Admin-managed FAQ content for the customer app's Help & Support screen.
model Faq {
  id        String          @id @default(cuid())
  topic     String
  question  String
  answer    String
  sortOrder Int             @default(0)
  status    CatalogueStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("faqs")
}

// ---------- Offers ----------
// Home page promo banners, fully admin-managed — title/image/link are free text so an admin can
// point an offer at any package, test or coupon without a code change per campaign.

model Offer {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  ctaLabel  String          @default("Book Now")
  ctaLink   String?
  sortOrder Int             @default(0)
  status    CatalogueStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("offers")
}

// ---------- Blog ----------
// Health-education articles, fully admin-managed. content is plain text with blank-line-separated
// paragraphs (no rich-text editor in scope) — rendered as <p> tags on the frontend.

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  category        String
  excerpt         String
  content         String
  coverImageUrl   String
  readTimeMinutes Int            @default(5)
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("blog_posts")
}

// ---------- Site Settings ----------
// Single-row, admin-managed site configuration. Always exactly one row (see
// SettingsService.getOrCreate) — there is no multi-tenant concept in this app, so a singleton
// table is simpler than a keyed config table. razorpayKeySecret/razorpayWebhookSecret are never
// returned by the public GET /settings endpoint (see SettingsService.getPublic).

model SiteSetting {
  id                     String   @id @default(cuid())
  logoUrl                String?
  faviconUrl             String?
  bannerUrl              String?
  address                String?
  email                  String?
  phone                  String?
  appStoreUrl            String?
  playStoreUrl           String?
  razorpayKeyId          String?
  razorpayKeySecret      String?
  razorpayWebhookSecret  String?
  onlinePaymentEnabled   Boolean  @default(true)
  codEnabled             Boolean  @default(true)
  privacyPolicyContent   String?
  termsConditionsContent String?
  updatedAt              DateTime @updatedAt

  @@map("site_settings")
}

// ---------- Contact Us ----------
// Submissions from the public Contact Us form. No auth required to submit (it's a public lead
// form); only admin can view/manage them.

enum ContactQueryStatus {
  NEW
  CONTACTED
}

model ContactQuery {
  id        String             @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  status    ContactQueryStatus @default(NEW)
  createdAt DateTime           @default(now())

  @@map("contact_queries")
}

// ---------- Callback Requests ----------
// Submissions from the sitewide "Get a Callback" sticky bar (CallbackBar.tsx) — deliberately a
// separate, minimal model from ContactQuery: that's a detailed inquiry form (name/email/message)
// on its own page, this is a one-tap "call me back" widget shown on every page that only ever
// collects a phone number. No auth required to submit; only admin can view/manage them.

enum CallbackRequestStatus {
  NEW
  CONTACTED
}

model CallbackRequest {
  id        String                @id @default(cuid())
  phone     String
  status    CallbackRequestStatus @default(NEW)
  createdAt DateTime              @default(now())

  @@map("callback_requests")
}

// ---------- Franchise Inquiries ----------
// Submissions from the /franchise page's "Request a franchise callback" form. No auth required to
// submit (public lead form, same convention as ContactQuery/CallbackRequest); only admin can
// view/manage them and follow up.

enum FranchiseInquiryStatus {
  NEW
  CONTACTED
}

model FranchiseInquiry {
  id                 String                 @id @default(cuid())
  name               String
  phone              String
  email              String?
  city               String
  investmentCapacity String
  message            String?
  status             FranchiseInquiryStatus @default(NEW)
  createdAt          DateTime               @default(now())

  @@map("franchise_inquiries")
}
